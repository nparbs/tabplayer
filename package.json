{
  "name": "tabplayer",
  "version": "1.0.0",
  "description": "Guitar Pro-style tab player with Songsterr import, built on alphaTab",
  "scripts": {
    "test": "node --test test/unit.test.mjs && node test/convert.test.mjs && node test/e2e.test.mjs",
    "start": "node server.js",
    "test:unit": "node --test test/unit.test.mjs",
    "test:convert": "node test/convert.test.mjs",
    "test:e2e": "node test/e2e.test.mjs",
    "desktop": "node scripts/desktop.mjs",
    "dist": "install-electron && electron-builder --win",
    "icons": "node scripts/make-icons.mjs",
    "test:desktop": "node test/desktop.test.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@coderline/alphatab": "^1.8.4",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "puppeteer-core": "^25.14.0"
  },
  "main": "electron/main.mjs",
  "build": {
    "appId": "com.nparbs.tabplayer",
    "productName": "TabPlayer",
    "copyright": "MIT licence",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "public/**",
      "server.js",
      "package.json",
      "LICENSE"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "TabPlayer"
    },
    "fileAssociations": [
      {
        "ext": [
          "gp",
          "gpx",
          "gp3",
          "gp4",
          "gp5",
          "gp7",
          "gp8"
        ],
        "name": "Guitar Pro file",
        "description": "Guitar Pro tablature",
        "icon": "build/icon.png"
      },
      {
        "ext": [
          "musicxml",
          "mxl"
        ],
        "name": "MusicXML file",
        "description": "MusicXML score",
        "icon": "build/icon.png"
      }
    ]
  }
}
